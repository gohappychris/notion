# ============================================================
#  증권 통합 잔고 대시보드 - 환경변수 예시
#  실제 값은 .env 에 채우고, .env 는 절대 커밋하지 않습니다(.gitignore).
#  GitHub Actions 에서는 같은 키들을 Repository Secrets 로 등록합니다.
# ============================================================

# --- 키움 REST API ---------------------------------------------------------
# 키움 REST API 포털(https://openapi.kiwoom.com)에서 사용 등록 후 발급
KIWOOM_APP_KEY=
KIWOOM_SECRET_KEY=
# 실거래="real", 모의투자="mock"  (먼저 mock 으로 검증 권장)
KIWOOM_ENV=mock

# --- 텔레그램 봇 (Phase 1) -------------------------------------------------
# @BotFather 로 봇 생성 후 받은 토큰 / 내 chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Notion (Phase 1) ------------------------------------------------------
# Notion Integration 토큰 + 생성된 DB ID 2개
NOTION_TOKEN=
NOTION_SNAPSHOTS_DB_ID=
NOTION_SUMMARY_DB_ID=

# --- 환율 (Phase 2, 미국주식 원화환산) -------------------------------------
# 한국수출입은행 환율 API 키 등 (선택)
FX_API_KEY=
